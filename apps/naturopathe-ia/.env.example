# ---------------------------------------------------------------------------
# NaturopatheIA — configuration
#
# Aucune de ces variables n'est préfixée NEXT_PUBLIC_ : elles restent
# exclusivement côté serveur et ne sont JAMAIS incluses dans le bundle client.
# ---------------------------------------------------------------------------

# Fournisseur de modèle actif : "gemini" ou "mistral".
AI_PROVIDER=gemini

# --- Google Gemini -----------------------------------------------------------
# Traitement hors UE. À réserver au développement et à la démonstration.
# Ne pas utiliser avec des documents de santé réels sans contrat adéquat.
GEMINI_API_KEY=

# Modèles (valeurs par défaut si non renseignés)
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025

# --- Mistral (traitement UE) -------------------------------------------------
# Recommandé dès qu'il s'agit de données de santé réelles.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# --- Limitation de débit -----------------------------------------------------
# Nombre de requêtes autorisées par fenêtre glissante, par adresse IP.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
